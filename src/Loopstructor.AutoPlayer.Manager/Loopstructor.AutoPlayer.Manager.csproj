<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Loopstructor.AutoPlayer.Manager</AssemblyName>
    <RootNamespace>Loopstructor.AutoPlayer.Manager</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\branding\manager.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Loopstructor.AutoPlayer.Core\Loopstructor.AutoPlayer.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Loopstructor.AutoPlayer.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\branding\manager-logo-256.png">
      <Link>Assets\Branding\manager-logo-256.png</Link>
      <LogicalName>Assets/Branding/manager-logo-256.png</LogicalName>
    </Resource>
    <Resource Include="..\..\assets\branding\cheat-logo-256.png">
      <Link>Assets\Branding\cheat-logo-256.png</Link>
      <LogicalName>Assets/Branding/cheat-logo-256.png</LogicalName>
    </Resource>
  </ItemGroup>
</Project>
