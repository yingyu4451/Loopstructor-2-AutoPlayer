<UserControl x:Class="Loopstructor.AutoPlayer.Manager.UI.CatalogDetailToolTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal"
             Width="340">
    <Border Padding="12"
            Background="#15120F"
            BorderBrush="#B27A3D"
            BorderThickness="2"
            CornerRadius="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" VerticalAlignment="Top" Background="#0B0A08" BorderBrush="#70492B" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#70492B" Text="◇" />
                    <Image Margin="3" Source="{Binding Icon}" Stretch="Uniform" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock FontSize="15" FontWeight="Bold" Foreground="#F0B23D" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,8" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#B9AA92" Text="{Binding EnumName}" TextWrapping="Wrap" />
                <Border Height="1" Margin="0,0,0,8" Background="#70492B" />
                <TextBlock Foreground="#F1EBDD" LineHeight="20" Text="{Binding Description}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
