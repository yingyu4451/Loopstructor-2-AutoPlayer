<Window x:Class="Loopstructor.AutoPlayer.Manager.UI.UpdateConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Loopstructor.AutoPlayer.Manager.UI.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:ClassModifier="internal"
        Title="安装 AutoPlayer 更新"
        Width="640"
        Height="390"
        MinWidth="600"
        MinHeight="370"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Loopstructor.AutoPlayer.Manager;component/Assets/Branding/manager-logo-256.png"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="DialogOnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="72" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GameTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <controls:MechanicalShell AccentBrush="{StaticResource OperationBlueBrush}"
                              BrandText="UPDATE READY"
                              LogoSource="/Loopstructor.AutoPlayer.Manager;component/Assets/Branding/manager-logo-256.png"
                              Title="发现可用更新">
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Padding="18" Style="{StaticResource InstrumentPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="72" Height="72" VerticalAlignment="Top" Background="#11110E" BorderBrush="{StaticResource BrassBrush}" BorderThickness="2">
                        <Image Margin="7" Source="/Loopstructor.AutoPlayer.Manager;component/Assets/Branding/manager-logo-256.png" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="AutoPlayer 更新已就绪" />
                        <Grid Margin="0,16,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Padding="10,7" Background="{StaticResource ScreenBrush}" BorderBrush="{StaticResource BronzeBrush}" BorderThickness="1">
                                <StackPanel><TextBlock Style="{StaticResource CaptionStyle}" Text="当前版本" /><TextBlock x:Name="CurrentVersionText" FontFamily="{StaticResource DataFont}" FontSize="16" Foreground="{StaticResource TextBrush}" /></StackPanel>
                            </Border>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" Foreground="{StaticResource OperationBlueBrush}" Text="→" />
                            <Border Grid.Column="2" Padding="10,7" Background="#182B36" BorderBrush="{StaticResource OperationBlueBrush}" BorderThickness="1">
                                <StackPanel><TextBlock Style="{StaticResource CaptionStyle}" Text="目标版本" /><TextBlock x:Name="LatestVersionText" FontFamily="{StaticResource DataFont}" FontSize="16" Foreground="{StaticResource TextBrush}" /></StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" LineHeight="20" Text="Updater 将等待游戏与 Manager 退出，校验下载内容后再替换工具文件；安装失败时会保留原版本。" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="LaterButton" MinWidth="116" Margin="0,0,8,0" Content="暂不更新" IsCancel="True" Click="LaterButtonOnClick" />
                <Button x:Name="ApplyButton" MinWidth="132" Style="{StaticResource BlueButtonStyle}" Content="开始更新" IsDefault="True" Click="ApplyButtonOnClick" />
            </StackPanel>
        </Grid>
    </controls:MechanicalShell>
</Window>
