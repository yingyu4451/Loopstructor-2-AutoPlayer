<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Loopstructor.AutoPlayer.Manager.UI.Controls">

    <Color x:Key="CoalColor">#0B0A08</Color>
    <Color x:Key="SootColor">#15120F</Color>
    <Color x:Key="ScreenColor">#11110E</Color>
    <Color x:Key="RaisedColor">#211A13</Color>
    <Color x:Key="BronzeDarkColor">#3A2517</Color>
    <Color x:Key="BronzeColor">#70492B</Color>
    <Color x:Key="BrassColor">#B27A3D</Color>
    <Color x:Key="GoldColor">#F0B23D</Color>
    <Color x:Key="SignalGreenColor">#78D13E</Color>
    <Color x:Key="OperationBlueColor">#328CC5</Color>
    <Color x:Key="DangerColor">#D74B31</Color>
    <Color x:Key="TextColor">#F1EBDD</Color>
    <Color x:Key="MutedTextColor">#B9AA92</Color>
    <Color x:Key="DisabledTextColor">#756A5A</Color>

    <SolidColorBrush x:Key="CoalBrush" Color="{StaticResource CoalColor}" />
    <SolidColorBrush x:Key="SootBrush" Color="{StaticResource SootColor}" />
    <SolidColorBrush x:Key="ScreenBrush" Color="{StaticResource ScreenColor}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="BronzeDarkBrush" Color="{StaticResource BronzeDarkColor}" />
    <SolidColorBrush x:Key="BronzeBrush" Color="{StaticResource BronzeColor}" />
    <SolidColorBrush x:Key="BrassBrush" Color="{StaticResource BrassColor}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="SignalGreenBrush" Color="{StaticResource SignalGreenColor}" />
    <SolidColorBrush x:Key="OperationBlueBrush" Color="{StaticResource OperationBlueColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />

    <!-- Shared geometry keeps sibling controls on the same baseline. -->
    <Thickness x:Key="ControlPadding">10,6</Thickness>

    <FontFamily x:Key="DisplayFont">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="BodyFont">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="DataFont">Cascadia Mono, Consolas</FontFamily>

    <DrawingBrush x:Key="InstrumentTexture" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#17140F" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Brush="#1D1812" Geometry="M0,0 H1 V24 H0 Z M12,0 H13 V24 H12 Z" />
                <GeometryDrawing Brush="#0D0C09" Geometry="M0,23 H24 V24 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource CoalBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="{x:Type controls:MechanicalShell}">
        <Setter Property="Background" Value="{StaticResource InstrumentTexture}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:MechanicalShell}">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Border Margin="8" BorderBrush="#090705" BorderThickness="7" CornerRadius="5" />
                        <Border Margin="13" BorderBrush="{StaticResource BronzeDarkBrush}" BorderThickness="7" CornerRadius="4" />
                        <Border Margin="19" BorderBrush="{StaticResource BrassBrush}" BorderThickness="2" CornerRadius="3" />
                        <Border Margin="23" BorderBrush="#24160E" BorderThickness="4" CornerRadius="2" />

                        <Grid Margin="34,78,34,28">
                            <Border Background="#B20A0907" BorderBrush="#8B5D3420" BorderThickness="1" CornerRadius="2" />
                            <ContentPresenter Margin="10" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>

                        <Border Height="18" Margin="72,24,72,0" VerticalAlignment="Top" Background="#20140D" BorderBrush="{StaticResource BronzeBrush}" BorderThickness="2" CornerRadius="2">
                            <Rectangle Margin="7,5" Fill="#4A2D18">
                                <Rectangle.OpacityMask>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,18,8" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="White" Geometry="M0,0 H11 L16,4 11,8 H0 Z" />
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Border>

                        <Border Width="420" Height="54" Margin="0,11,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Background="#14100C" BorderBrush="#0A0806" BorderThickness="5" CornerRadius="4">
                            <Border Margin="2" BorderBrush="{StaticResource BrassBrush}" BorderThickness="2" CornerRadius="2">
                                <Grid>
                                    <Rectangle Margin="8,5" Fill="#1D1914" />
                                    <TextBlock Style="{DynamicResource PlaqueTextStyle}" Text="{TemplateBinding Title}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </Border>

                        <Grid Width="54" Height="54" Margin="20,11,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Ellipse Fill="#1A130E" Stroke="#0A0806" StrokeThickness="5" />
                            <Ellipse Margin="6" Fill="#6E482B" Stroke="#B27A3D" StrokeThickness="2" />
                            <Ellipse Width="14" Height="14" Fill="#12100D" Stroke="#090705" StrokeThickness="3" />
                            <Path Data="M27,4 V14 M27,40 V50 M4,27 H14 M40,27 H50 M10,10 L17,17 M37,37 L44,44 M44,10 L37,17 M17,37 L10,44" Stroke="#B27A3D" StrokeThickness="5" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                        </Grid>
                        <Grid Width="54" Height="54" Margin="0,11,20,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Ellipse Fill="#1A130E" Stroke="#0A0806" StrokeThickness="5" />
                            <Ellipse Margin="6" Fill="#6E482B" Stroke="#B27A3D" StrokeThickness="2" />
                            <Ellipse Width="14" Height="14" Fill="#12100D" Stroke="#090705" StrokeThickness="3" />
                            <Path Data="M27,4 V14 M27,40 V50 M4,27 H14 M40,27 H50 M10,10 L17,17 M37,37 L44,44 M44,10 L37,17 M17,37 L10,44" Stroke="#B27A3D" StrokeThickness="5" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                        </Grid>

                        <ItemsControl Margin="24,0,0,18" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <Ellipse Width="10" Height="10" Margin="0,0,5,0" Fill="#17110D" Stroke="#B27A3D" />
                            <Ellipse Width="10" Height="10" Margin="0,0,5,0" Fill="#17110D" Stroke="#B27A3D" />
                            <Ellipse Width="10" Height="10" Fill="#17110D" Stroke="#B27A3D" />
                        </ItemsControl>
                        <TextBlock Margin="0,0,28,13" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontFamily="{StaticResource DataFont}" FontSize="11" Foreground="#9D7A50" Text="{TemplateBinding Subtitle}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlaqueTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#E6B75A" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style x:Key="DataTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DataFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="InstrumentPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InstrumentTexture}" />
        <Setter Property="BorderBrush" Value="{StaticResource BronzeBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="InsetPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ScreenBrush}" />
        <Setter Property="BorderBrush" Value="#4E3522" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource BronzeDarkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrassBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Outer"
                        Padding="2"
                        Background="#0A0806"
                        BorderBrush="#0A0806"
                        BorderThickness="1"
                        CornerRadius="3"
                        SnapsToDevicePixels="True">
                        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1">
                            <Grid>
                                <Border Height="2" Margin="5,3,5,0" VerticalAlignment="Top" Background="#55FFFFFF" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            <Setter TargetName="Body" Property="Background" Value="#62401F" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="#24170E" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource SignalGreenBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#355B20" />
        <Setter Property="BorderBrush" Value="{StaticResource SignalGreenBrush}" />
        <Setter Property="Foreground" Value="#EAFEDD" />
    </Style>

    <Style x:Key="GoldButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#654218" />
        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
    </Style>

    <Style x:Key="BlueButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#183B51" />
        <Setter Property="BorderBrush" Value="{StaticResource OperationBlueBrush}" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#5E2118" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource SignalGreenBrush}" />
        <Setter Property="Background" Value="{StaticResource ScreenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BronzeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SelectionBrush" Value="#2D789C" />
        <Setter Property="SelectionOpacity" Value="0.92" />
        <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource SignalGreenBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="RichTextBox">
        <Setter Property="SelectionBrush" Value="#2D789C" />
        <Setter Property="SelectionOpacity" Value="0.92" />
        <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource ScreenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BronzeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            x:Name="DropToggle"
                            Focusable="False"
                            ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        x:Name="ToggleFrame"
                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        CornerRadius="2">
                                        <Grid>
                                            <Border
                                                Width="34"
                                                HorizontalAlignment="Right"
                                                Background="#2A1D13"
                                                BorderBrush="#5B3B24"
                                                BorderThickness="1,0,0,0">
                                                <Path
                                                    Width="10"
                                                    Height="6"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M0,0 L10,0 L5,6 Z"
                                                    Fill="{StaticResource GoldBrush}"
                                                    Stretch="Fill" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleFrame" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter
                            x:Name="SelectionPresenter"
                            Margin="10,3,40,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                            IsHitTestVisible="False"
                            TextElement.Foreground="{TemplateBinding Foreground}" />

                        <TextBox
                            x:Name="PART_EditableTextBox"
                            Margin="2,2,36,2"
                            Padding="8,3"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{TemplateBinding Foreground}"
                            IsReadOnly="{TemplateBinding IsReadOnly}"
                            Visibility="Collapsed" />

                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Fade">
                            <Border
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="320"
                                Margin="0,3,0,0"
                                Background="{StaticResource ScreenBrush}"
                                BorderBrush="{StaticResource GoldBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="SelectionPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource SignalGreenBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource ScreenBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#4C331B" />
                <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#654218" />
                <Setter Property="Foreground" Value="#FFF7DF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="Switch"
                            Width="36"
                            Height="24"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#201A14"
                            BorderBrush="{StaticResource BronzeBrush}"
                            BorderThickness="2"
                            CornerRadius="2">
                            <Border
                                x:Name="Lamp"
                                Width="12"
                                Height="12"
                                Margin="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#625848"
                                BorderBrush="#8C7D67"
                                BorderThickness="1"
                                CornerRadius="1" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Switch" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Switch" Property="BorderBrush" Value="{StaticResource SignalGreenBrush}" />
                            <Setter TargetName="Lamp" Property="Background" Value="{StaticResource SignalGreenBrush}" />
                            <Setter TargetName="Lamp" Property="BorderBrush" Value="#D9FFBF" />
                            <Setter TargetName="Lamp" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Switch" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            <Setter TargetName="Lamp" Property="Background" Value="{StaticResource GoldBrush}" />
                            <Setter TargetName="Lamp" Property="HorizontalAlignment" Value="Center" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Switch" Property="BorderBrush" Value="{StaticResource OperationBlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BronzeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel
                            x:Name="HeaderPanel"
                            Grid.Row="0"
                            Margin="0,0,0,-1"
                            Panel.ZIndex="2"
                            IsItemsHost="True"
                            KeyboardNavigation.TabIndex="1" />
                        <Border
                            x:Name="ContentFrame"
                            Grid.Row="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0,2,2,2"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                x:Name="PART_SelectedContentHost"
                                Margin="{TemplateBinding Padding}"
                                ContentSource="SelectedContent"
                                SnapsToDevicePixels="True" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Background" Value="#281B12" />
        <Setter Property="BorderBrush" Value="{StaticResource BronzeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Tab" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2,2,0,0">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Tab" Property="Background" Value="#3A2818" />
                            <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            <Setter TargetName="Tab" Property="BorderThickness" Value="1,1,1,0" />
                            <Setter Property="Panel.ZIndex" Value="3" />
                            <Setter Property="Margin" Value="0,0,6,-1" />
                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource SignalGreenBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource ScreenBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BronzeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#38291D" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="RowBackground" Value="#11110E" />
        <Setter Property="AlternatingRowBackground" Value="#17140F" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="AutoGenerateColumns" Value="False" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#2B1D13" />
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="BorderBrush" Value="#5B3B24" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#654218" />
                <Setter Property="Foreground" Value="#FFF7DF" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#392619" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource ScreenBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BronzeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#654218" />
                <Setter Property="Foreground" Value="#FFF7DF" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#392619" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="Background" Value="#080806" />
        <Setter Property="BorderBrush" Value="{StaticResource BronzeBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border
                        x:Name="ProgressFrame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2"
                        SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Track" Margin="2" ClipToBounds="True">
                            <Border Background="#100E0B" />
                            <Border
                                x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="1" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ProgressFrame" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="MinHeight" Value="7" />
        <Setter Property="MinWidth" Value="7" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Background" Value="{StaticResource BronzeDarkBrush}" />
        <Setter Property="Cursor" Value="SizeNS" />
        <Setter Property="ToolTip" Value="拖动调整上下区块大小" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Border
                            x:Name="Rail"
                            Height="3"
                            VerticalAlignment="Center"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#8A5B32"
                            BorderThickness="0,1"
                            SnapsToDevicePixels="True" />
                        <Border
                            x:Name="Grip"
                            Width="70"
                            Height="7"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#291B12"
                            BorderBrush="{StaticResource BrassBrush}"
                            BorderThickness="1"
                            CornerRadius="1"
                            SnapsToDevicePixels="True">
                            <StackPanel x:Name="GripMarks" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                <Border Width="5" Height="2" Margin="0,0,4,0" Background="{StaticResource GoldBrush}" />
                                <Border Width="5" Height="2" Margin="0,0,4,0" Background="{StaticResource GoldBrush}" />
                                <Border Width="5" Height="2" Margin="0,0,4,0" Background="{StaticResource GoldBrush}" />
                                <Border Width="5" Height="2" Background="{StaticResource GoldBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="#4B311C" />
                            <Setter TargetName="Grip" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Grip" Property="BorderBrush" Value="{StaticResource SignalGreenBrush}" />
                        </Trigger>
                        <Trigger Property="ResizeDirection" Value="Columns">
                            <Setter Property="Cursor" Value="SizeWE" />
                            <Setter Property="ToolTip" Value="拖动调整左右区块大小" />
                            <Setter TargetName="Rail" Property="Width" Value="3" />
                            <Setter TargetName="Rail" Property="Height" Value="Auto" />
                            <Setter TargetName="Rail" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="Rail" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="Rail" Property="BorderThickness" Value="1,0" />
                            <Setter TargetName="Grip" Property="Width" Value="7" />
                            <Setter TargetName="Grip" Property="Height" Value="70" />
                            <Setter TargetName="GripMarks" Property="Orientation" Value="Vertical" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        x:Name="ThumbBody"
                        Background="#5E3D25"
                        BorderBrush="{StaticResource BrassBrush}"
                        BorderThickness="1"
                        CornerRadius="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBody" Property="Background" Value="#76502F" />
                            <Setter TargetName="ThumbBody" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBody" Property="Background" Value="#3C2718" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Background" Value="#090806" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#5B3B24" BorderThickness="1" SnapsToDevicePixels="True">
                        <Track
                            x:Name="PART_Track"
                            Focusable="False"
                            IsDirectionReversed="True"
                            Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    x:Name="DecreasePageButton"
                                    Command="ScrollBar.PageUpCommand"
                                    Style="{StaticResource ScrollPageButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    x:Name="IncreasePageButton"
                                    Command="ScrollBar.PageDownCommand"
                                    Style="{StaticResource ScrollPageButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="DecreasePageButton" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="IncreasePageButton" Property="Command" Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="15" />
                <Setter Property="Width" Value="Auto" />
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="15" />
                <Setter Property="Height" Value="Auto" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="#5A3B25" />
        <Setter Property="Margin" Value="0,8" />
    </Style>
</ResourceDictionary>
