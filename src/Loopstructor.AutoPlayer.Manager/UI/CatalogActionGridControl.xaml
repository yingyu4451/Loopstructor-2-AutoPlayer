<UserControl x:Class="Loopstructor.AutoPlayer.Manager.UI.CatalogActionGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Loopstructor.AutoPlayer.Manager.UI"
             x:ClassModifier="internal"
             MinHeight="166">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Loopstructor.AutoPlayer.Manager;component/UI/GameTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="7" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource ScreenBrush}"
                BorderBrush="{StaticResource BronzeBrush}"
                BorderThickness="1"
                CornerRadius="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Margin="1" Background="#2A2118" BorderBrush="#5B3B24" BorderThickness="0,0,1,0">
                    <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M7,1 A6,6 0 1 0 7,13 A6,6 0 1 0 7,1 M11.3,11.3 L16,16"
                              Fill="Transparent"
                              Stroke="{StaticResource GoldBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Square"
                              StrokeEndLineCap="Square" />
                    </Viewbox>
                </Border>
                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox"
                             Padding="9,6"
                             BorderThickness="0"
                             Background="Transparent"
                             AutomationProperties.Name="搜索资源"
                             TextChanged="SearchBox_OnTextChanged" />
                    <TextBlock x:Name="SearchHint"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#8D806E"
                               IsHitTestVisible="False"
                               Text="搜索中文名或枚举名…" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                MinHeight="112"
                Background="{StaticResource ScreenBrush}"
                BorderBrush="#4E3522"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="ItemsScrollViewer_OnScrollChanged">
                <ItemsControl x:Name="ItemsHost" Margin="6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CatalogActionChoice}">
                            <Border Width="136"
                                    Height="76"
                                    Margin="3"
                                    Padding="4"
                                    CornerRadius="2"
                                    Focusable="True"
                                    Cursor="Hand"
                                    AutomationProperties.Name="{Binding AutomationName}"
                                    ToolTipService.InitialShowDelay="1000"
                                    ToolTipService.ShowDuration="30000"
                                    PreviewMouseDown="Choice_OnPreviewMouseDown">
                                <Border.ToolTip>
                                    <ToolTip DataContext="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource Self}}">
                                        <local:CatalogDetailToolTip />
                                    </ToolTip>
                                </Border.ToolTip>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#211B16" />
                                        <Setter Property="BorderBrush" Value="#654529" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#26351E" />
                                                <Setter Property="BorderBrush" Value="{StaticResource SignalGreenBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3B2B1D" />
                                                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource SignalGreenBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" VerticalAlignment="Center" Background="#15120F" BorderBrush="#5B3B24" BorderThickness="1">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BronzeBrush}" Text="◇" />
                                            <Image Margin="2" Source="{Binding Item.Icon}" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            MinWidth="22"
                                            Padding="4,1"
                                            CornerRadius="7"
                                            Visibility="{Binding CountVisibility}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#7A2B20" />
                                                <Setter Property="BorderBrush" Value="#E48E46" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBinary}" Value="True">
                                                        <Setter Property="Background" Value="#315F28" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource SignalGreenBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource DataFont}" FontSize="10" FontWeight="Bold" Foreground="#F5E8D4" Text="{Binding BadgeText}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="{Binding Item.DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource DataFont}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Item.EnumName}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="InteractionText"
                   Grid.Row="3"
                   Margin="1,6,0,0"
                   Foreground="{StaticResource GoldBrush}"
                   Text="左键执行"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
