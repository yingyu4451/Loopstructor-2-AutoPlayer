<UserControl x:Class="Loopstructor.AutoPlayer.Manager.UI.EnchantmentSelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Loopstructor.AutoPlayer.Manager.UI"
             x:ClassModifier="internal"
             MinHeight="250">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Loopstructor.AutoPlayer.Manager;component/UI/GameTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource ScreenBrush}" BorderBrush="{StaticResource BronzeBrush}" BorderThickness="1" CornerRadius="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Margin="1" Background="#2A2118" BorderBrush="#5B3B24" BorderThickness="0,0,1,0">
                    <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M7,1 A6,6 0 1 0 7,13 A6,6 0 1 0 7,1 M11.3,11.3 L16,16"
                              Fill="Transparent"
                              Stroke="{StaticResource GoldBrush}"
                              StrokeThickness="1.7" />
                    </Viewbox>
                </Border>
                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox"
                             Padding="9,6"
                             BorderThickness="0"
                             Background="Transparent"
                             AutomationProperties.Name="搜索附魔"
                             TextChanged="SearchBox_OnTextChanged"
                             ToolTip="可按中文名、枚举名、家族或等级搜索" />
                    <TextBlock x:Name="SearchHint"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#8D806E"
                               IsHitTestVisible="False"
                               Text="搜索附魔中文名、枚举名或家族…" />
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="2"
                MinHeight="190"
                Background="{StaticResource ScreenBrush}"
                BorderBrush="{StaticResource BronzeBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="ItemsScrollViewer_OnScrollChanged">
                <ItemsControl x:Name="ItemsHost" Margin="8">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2,8,2,5">
                                        <Border DockPanel.Dock="Left" Width="4" Margin="0,1,8,1" Background="{StaticResource GoldBrush}" />
                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:EnchantmentChoice}">
                            <Border Width="140"
                                    Height="78"
                                    Margin="3"
                                    Padding="6"
                                    Background="#211D19"
                                    BorderBrush="#664525"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Focusable="True"
                                    AutomationProperties.Name="{Binding AutomationName}"
                                    ToolTipService.InitialShowDelay="1000"
                                    ToolTipService.ShowDuration="30000"
                                    PreviewMouseDown="Choice_OnPreviewMouseDown">
                                <Border.ToolTip>
                                    <ToolTip DataContext="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource Self}}">
                                        <local:CatalogDetailToolTip />
                                    </ToolTip>
                                </Border.ToolTip>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="#3C321C" />
                                                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource SignalGreenBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" VerticalAlignment="Center" Background="#171513" BorderBrush="#5B3B24" BorderThickness="1">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BronzeBrush}" Text="◇" />
                                            <Image Margin="2" Source="{Binding Item.Icon}" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            MinWidth="24"
                                            Padding="4,1"
                                            Background="#B82B20"
                                            BorderBrush="#FFB84A"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding BadgeVisibility}">
                                        <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource DataFont}" FontSize="11" FontWeight="Bold" Foreground="White" Text="{Binding Level}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="Bold" LineHeight="18" Foreground="{StaticResource TextBrush}" Text="{Binding Item.DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0" FontFamily="{StaticResource DataFont}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Item.EnumName}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,7,0,0">
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedTextBrush}" Text="已选 0 种附魔" />
            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource GoldBrush}" Text="左键增加层数，右键减少层数" />
        </DockPanel>
    </Grid>
</UserControl>
