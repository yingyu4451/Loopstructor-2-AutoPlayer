<UserControl x:Class="Loopstructor.AutoPlayer.Manager.UI.CatalogPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Loopstructor.AutoPlayer.Manager.UI"
             x:ClassModifier="internal"
             MinWidth="170"
             MinHeight="44"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Loopstructor.AutoPlayer.Manager;component/UI/GameTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="PickerRoot">
        <Border x:Name="PickerFrame">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource ScreenBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BronzeBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="2" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SelectedIconColumn" Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SelectedIconFrame"
                        Grid.Column="0"
                        Margin="1"
                        Background="#241E18"
                        BorderBrush="#5B3B24"
                        BorderThickness="0,0,1,0"
                        IsHitTestVisible="False">
                    <Grid>
                        <TextBlock x:Name="SelectedIconFallback"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource DataFont}"
                                   FontSize="17"
                                   Foreground="{StaticResource BronzeBrush}"
                                   Text="◇" />
                        <Image x:Name="SelectedIcon"
                               Width="30"
                               Height="30"
                               Margin="4"
                               Stretch="Uniform" />
                    </Grid>
                </Border>
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         MinHeight="42"
                         Padding="9,7"
                         BorderThickness="0"
                         Background="Transparent"
                         TextChanged="SearchBox_OnTextChanged"
                         GotKeyboardFocus="SearchBox_OnGotKeyboardFocus"
                         PreviewMouseLeftButtonDown="SearchBox_OnPreviewMouseLeftButtonDown"
                         PreviewKeyDown="SearchBox_OnPreviewKeyDown" />
                <Button x:Name="DropButton"
                        Grid.Column="2"
                        MinWidth="38"
                        MinHeight="40"
                        Padding="0"
                        BorderThickness="1,0,0,0"
                        Focusable="False"
                        ToolTip="打开候选项"
                        Click="DropButton_OnClick">
                    <Path Width="10"
                          Height="6"
                          Stretch="Fill"
                          Fill="{StaticResource GoldBrush}"
                          Data="M 0 0 L 10 0 L 5 6 Z" />
                </Button>
            </Grid>
        </Border>

        <Popup x:Name="ResultsPopup"
               Placement="Bottom"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Border MaxHeight="360"
                    Margin="0,3,0,0"
                    Background="{StaticResource ScreenBrush}"
                    BorderBrush="{StaticResource GoldBrush}"
                    BorderThickness="1"
                    CornerRadius="2">
                <Grid>
                    <ListBox x:Name="ResultsList"
                             PreviewKeyDown="ResultsList_OnPreviewKeyDown"
                             PreviewMouseLeftButtonUp="ResultsList_OnPreviewMouseLeftButtonUp"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CatalogPickerItem}">
                                <Grid MinHeight="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38"
                                            Height="38"
                                            Margin="0,0,10,0"
                                            Background="#241E18"
                                            BorderBrush="#5B3B24"
                                            BorderThickness="1"
                                            Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource DataFont}"
                                                       FontSize="16"
                                                       Foreground="{StaticResource BronzeBrush}"
                                                       Text="◇">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Margin="2" Source="{Binding Icon}" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    Padding="6,1"
                                                    Background="#533719"
                                                    BorderBrush="{StaticResource BrassBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LevelLabel}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontFamily="{StaticResource DataFont}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource GoldBrush}"
                                                           Text="{Binding LevelLabel}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,3,0,0"
                                                   FontFamily="{StaticResource DataFont}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding TechnicalLabel}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText"
                               Margin="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="没有匹配项"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
