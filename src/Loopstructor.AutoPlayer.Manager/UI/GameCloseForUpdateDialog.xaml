<Window x:Class="Loopstructor.AutoPlayer.Manager.UI.GameCloseForUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Loopstructor.AutoPlayer.Manager.UI.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:ClassModifier="internal"
        Title="关闭游戏后更新 AutoPlayer"
        Width="660"
        Height="430"
        MinWidth="620"
        MinHeight="410"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Loopstructor.AutoPlayer.Manager;component/Assets/Branding/manager-logo-256.png"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="DialogOnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="72" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GameTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <controls:MechanicalShell AccentBrush="{StaticResource GoldBrush}"
                              BrandText="SAFE UPDATE"
                              LogoSource="/Loopstructor.AutoPlayer.Manager;component/Assets/Branding/manager-logo-256.png"
                              Title="关闭游戏后更新">
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Padding="18" Style="{StaticResource InstrumentPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="72"
                            Height="72"
                            VerticalAlignment="Top"
                            Background="#11110E"
                            BorderBrush="{StaticResource BrassBrush}"
                            BorderThickness="2">
                        <Grid>
                            <Image Margin="7"
                                   Source="/Loopstructor.AutoPlayer.Manager;component/Assets/Branding/manager-logo-256.png"
                                   Stretch="Uniform" />
                            <Ellipse Width="18"
                                     Height="18"
                                     Margin="0,0,4,4"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Fill="{StaticResource GoldBrush}"
                                     Stroke="#21150D"
                                     StrokeThickness="3" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}"
                                   Text="检测到 Skyspine 仍在运行" />
                        <Border Margin="0,14,0,12"
                                Padding="12,9"
                                Background="{StaticResource ScreenBrush}"
                                BorderBrush="{StaticResource BronzeBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="游戏进程" />
                                <TextBlock x:Name="ProcessText"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           FontFamily="{StaticResource DataFont}"
                                           FontSize="14"
                                           Foreground="{StaticResource TextBrush}" />
                            </Grid>
                        </Border>
                        <TextBlock Foreground="{StaticResource TextBrush}"
                                   LineHeight="21"
                                   Text="更新前需要先关闭游戏，避免正在加载的插件文件影响安装。"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   LineHeight="20"
                                   Text="选择“关闭游戏并更新”后，Manager 只会请求游戏正常退出并等待；不会强制结束进程。请先保存当前进度。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        MinWidth="116"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="暂不更新"
                        Content="暂不更新"
                        IsCancel="True"
                        Click="CancelButtonOnClick" />
                <Button x:Name="CloseAndUpdateButton"
                        MinWidth="168"
                        AutomationProperties.Name="关闭游戏并更新"
                        Content="关闭游戏并更新"
                        IsDefault="True"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="CloseAndUpdateButtonOnClick" />
            </StackPanel>
        </Grid>
    </controls:MechanicalShell>
</Window>
