<Window x:Class="Loopstructor.AutoPlayer.Manager.UI.CheatForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:controls="clr-namespace:Loopstructor.AutoPlayer.Manager.UI.Controls"
         xmlns:local="clr-namespace:Loopstructor.AutoPlayer.Manager.UI"
         xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
         x:ClassModifier="internal"
         Title="Loopstructor 2.AutoPlayer 作弊工具"
         Icon="/Loopstructor.AutoPlayer.Manager;component/Assets/Branding/cheat-logo-256.png"
         Width="1280"
         Height="860"
         MinWidth="980"
         MinHeight="680"
         WindowStartupLocation="CenterScreen"
         ResizeMode="CanResize"
         WindowStyle="None"
         AllowsTransparency="False"
         ShowInTaskbar="True"
         SnapsToDevicePixels="True"
         UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="72"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Loopstructor.AutoPlayer.Manager;component/UI/GameTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CheatSectionStyle" TargetType="Border" BasedOn="{StaticResource InstrumentPanelStyle}">
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <Style x:Key="CheatCompactSectionStyle" TargetType="Border" BasedOn="{StaticResource CheatSectionStyle}">
                <Setter Property="Padding" Value="12,10" />
            </Style>
            <Style x:Key="CheatStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource DataTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="CheatGridTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="CheatScrollPageStyle" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="{TemplateBinding Background}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CheatScrollThumbStyle" TargetType="Thumb">
                <Setter Property="MinWidth" Value="6" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Margin="1"
                                    Background="{StaticResource BronzeBrush}"
                                    BorderBrush="{StaticResource BrassBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CheatHorizontalScrollThumbStyle" TargetType="Thumb" BasedOn="{StaticResource CheatScrollThumbStyle}">
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="MinHeight" Value="8" />
            </Style>
            <ControlTemplate x:Key="CheatVerticalScrollTemplate" TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}" BorderBrush="#4E3522" BorderThickness="1">
                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource CheatScrollPageStyle}" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource CheatScrollThumbStyle}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource CheatScrollPageStyle}" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate>
            <ControlTemplate x:Key="CheatHorizontalScrollTemplate" TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}" BorderBrush="#4E3522" BorderThickness="1">
                    <Track x:Name="PART_Track" Orientation="Horizontal">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource CheatScrollPageStyle}" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource CheatHorizontalScrollThumbStyle}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource CheatScrollPageStyle}" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate>
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="9" />
                <Setter Property="Background" Value="{StaticResource ScreenBrush}" />
                <Setter Property="Template" Value="{StaticResource CheatVerticalScrollTemplate}" />
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Height" Value="9" />
                        <Setter Property="Template" Value="{StaticResource CheatHorizontalScrollTemplate}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CheatNavigationTabStyle" TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="Background" Value="#241A12" />
                <Setter Property="BorderBrush" Value="{StaticResource BronzeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,9" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="50" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid Margin="2,4,2,2">
                                <Border x:Name="PlateShadow"
                                        Margin="0,3,0,0"
                                        Background="#090705"
                                        BorderBrush="#090705"
                                        BorderThickness="2"
                                        CornerRadius="2" />
                                <Border x:Name="Plate"
                                        Margin="2,0,2,3"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="2">
                                    <Grid>
                                        <Border Margin="4" BorderBrush="#4B3220" BorderThickness="1" CornerRadius="1" />
                                        <Grid Margin="{TemplateBinding Padding}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="SignalLamp"
                                                     Width="7"
                                                     Height="7"
                                                     VerticalAlignment="Center"
                                                     Fill="#3B3025"
                                                     Stroke="#725036"
                                                     StrokeThickness="1" />
                                            <ContentPresenter Grid.Column="1"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              ContentSource="Header" />
                                            <Path Grid.Column="2"
                                                  Width="7"
                                                  Height="7"
                                                  VerticalAlignment="Center"
                                                  Data="M3.5,0 L7,3.5 3.5,7 0,3.5 Z"
                                                  Fill="#4B3220"
                                                  Stretch="Fill" />
                                        </Grid>
                                        <Border x:Name="LockBar"
                                                Height="3"
                                                Margin="16,0"
                                                VerticalAlignment="Bottom"
                                                Background="#4B3220" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Plate" Property="Margin" Value="2,2,2,1" />
                                    <Setter TargetName="Plate" Property="Background" Value="#4A351C" />
                                    <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                    <Setter TargetName="Plate" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="SignalLamp" Property="Fill" Value="{StaticResource SignalGreenBrush}" />
                                    <Setter TargetName="SignalLamp" Property="Stroke" Value="#D7FFC4" />
                                    <Setter TargetName="LockBar" Property="Background" Value="{StaticResource GoldBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource SignalGreenBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource BrassBrush}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True" />
                                        <Condition Property="IsMouseOver" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Plate" Property="Background" Value="{StaticResource DisabledControlBackgroundBrush}" />
                                    <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource DisabledControlBorderBrush}" />
                                    <Setter TargetName="SignalLamp" Property="Fill" Value="#24211D" />
                                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CheatNavigationTabControlStyle" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource BronzeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid x:Name="NavigationRail"
                                      Grid.Row="0"
                                      Height="56"
                                      AutomationProperties.Name="作弊功能机械传送轨道"
                                      Panel.ZIndex="2">
                                    <Border Margin="0,5,0,3"
                                            Background="#100C09"
                                            BorderBrush="#090705"
                                            BorderThickness="3"
                                            CornerRadius="2" />
                                    <Border Margin="4,9,4,7"
                                            Background="{StaticResource InstrumentTexture}"
                                            BorderBrush="{StaticResource BronzeBrush}"
                                            BorderThickness="2"
                                            CornerRadius="1">
                                        <Grid>
                                            <Rectangle Height="3" Margin="10,5" VerticalAlignment="Top" Fill="#4B3220" />
                                            <Rectangle Height="3" Margin="10,5" VerticalAlignment="Bottom" Fill="#4B3220" />
                                        </Grid>
                                    </Border>
                                    <UniformGrid Rows="1"
                                                 Columns="6"
                                                 IsItemsHost="True" />
                                </Grid>
                                <Border Grid.Row="1"
                                        Margin="0,-2,0,0"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="0,0,2,2">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" ContentSource="SelectedContent" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <controls:MechanicalShell x:Name="Shell"
                              AccentBrush="{StaticResource DangerBrush}"
                              BrandText="CHEAT TOOL"
                              LogoSource="/Loopstructor.AutoPlayer.Manager;component/Assets/Branding/cheat-logo-256.png"
                              Title="SKYSPINE / 作弊工具">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="14,10"
                    Background="{StaticResource ScreenBrush}"
                    BorderBrush="{StaticResource BronzeBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}"
                                   Text="作弊运行控制" />
                        <Border x:Name="_runControlStateBadge"
                                MinWidth="68"
                                Margin="12,0,0,0"
                                Padding="9,3"
                                VerticalAlignment="Center"
                                Background="{Binding RunStatePanel}"
                                BorderBrush="{Binding RunStateAccent}"
                                BorderThickness="1"
                                CornerRadius="2"
                                AutomationProperties.HelpText="{Binding RunStateDetail}"
                                AutomationProperties.Name="{Binding RunStateLabel, StringFormat=作弊运行状态：{0}}"
                                ToolTip="{Binding RunStateDetail}">
                            <TextBlock x:Name="_runControlStateText"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{Binding RunStateAccent}"
                                       Text="{Binding RunStateLabel}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="_runRestrictionNotice"
                            Grid.Column="1"
                            MaxWidth="520"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource GoldBrush}"
                            FontSize="12"
                            Text="自动游玩正在运行：停止自动游玩后可恢复修改；目录浏览、对象查看、敌人 ID 和 Buff 显示仍可使用。"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    <Button x:Name="_catalogRefreshButton"
                            Grid.Column="2"
                            MinWidth="112"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Content="刷新目录"
                            AutomationProperties.Name="刷新全部作弊目录" />
                    <CheckBox x:Name="_enableCheck"
                              Grid.Column="3"
                              Margin="18,0,0,0"
                              VerticalAlignment="Center"
                              FontSize="15"
                              FontWeight="Bold"
                              Content="开启作弊模式"
                              ToolTip="通过安全握手后可随时启用；自动游玩期间仅开放查询、怪物 ID 和 Buff 监视。" />
                </Grid>
            </Border>

            <TabControl x:Name="_tabs"
                        Grid.Row="1"
                        Style="{StaticResource CheatNavigationTabControlStyle}"
                        ItemContainerStyle="{StaticResource CheatNavigationTabStyle}">
                <TabItem Header="战车">
                    <local:VehicleCheatPage x:Name="_vehiclePage" />
                </TabItem>

                <TabItem Header="道具">
                    <local:ItemsCheatPage x:Name="_itemsPage" />
                </TabItem>

                <TabItem Header="遗物">
                    <local:RelicsCheatPage x:Name="_relicsPage" />
                </TabItem>

                <TabItem Header="战斗">
                    <Grid Margin="8,12,8,8">
                        <StackPanel>
                            <Border x:Name="_battleStateMutationSection" Style="{StaticResource CheatCompactSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="战场状态" />
                                    <Grid Height="40" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="_baseGodModeCheck" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Content="基地无敌" />
                                        <CheckBox x:Name="_mapSkipCheck" Grid.Column="2" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Content="地图节点自由跳转" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="_battleWaveMutationSection" Style="{StaticResource CheatCompactSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="波次操作" />
                                    <Grid Height="40" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="_endWaveButton" VerticalAlignment="Stretch" Style="{StaticResource DangerButtonStyle}" Content="结束当前波次" />
                                        <Button x:Name="_clearEnemiesButton" Grid.Column="2" VerticalAlignment="Stretch" Style="{StaticResource DangerButtonStyle}" Content="清除所有敌人" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CheatCompactSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="敌人信息" />
                                    <Grid Height="40" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="_enemyIdOverlayCheck"
                                                  VerticalAlignment="Center"
                                                  FontSize="15"
                                                  FontWeight="Bold"
                                                  Content="显示敌人 ID" />
                                        <CheckBox x:Name="_enemyBuffOverlayCheck"
                                                  Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  FontSize="15"
                                                  FontWeight="Bold"
                                                  Content="显示 Buff 图标与时间" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="对象属性">
                    <ScrollViewer x:Name="_objectPageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8,12,8,0">
                            <Border Style="{StaticResource CheatSectionStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0" VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="当前战车" />
                                        <Button x:Name="_vehicleRefreshButton" Grid.Column="2" Content="刷新战车" />
                                        <TextBlock x:Name="_vehicleSummary" Grid.Column="4" Style="{StaticResource CheatStatusStyle}" Text="尚未读取战车" />
                                    </Grid>
                                    <DataGrid x:Name="_vehicleGrid" Height="275" RowHeight="52" IsReadOnly="True" SelectionChanged="VehicleGrid_OnSelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="52" Header="图标">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="40" Height="40">
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BronzeBrush}" Text="◇" />
                                                            <Image Source="{Binding Icon}" Stretch="Uniform" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Width="78" Header="战车 ID" Binding="{Binding VehicleId}" />
                                            <DataGridTextColumn Width="135" Header="枚举名" Binding="{Binding EnumName}" />
                                            <DataGridTextColumn Width="120" Header="中文名" Binding="{Binding Name}" />
                                            <DataGridTextColumn Width="58" Header="等级" Binding="{Binding Level}" />
                                            <DataGridTemplateColumn Width="*" MinWidth="210" Header="已有附魔">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ItemsControl ItemsSource="{Binding Enchantments}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="38" Height="38" Margin="0,3,5,3" Padding="3" Background="#2A2118" BorderBrush="#5A3B25" BorderThickness="1" ToolTip="{Binding Label}">
                                                                        <Grid>
                                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BronzeBrush}" Text="◇" />
                                                                            <Image Source="{Binding Icon}" Stretch="Uniform" />
                                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="2,0" Background="#CC17120D" BorderBrush="{StaticResource BrassBrush}" BorderThickness="1">
                                                                                <TextBlock FontFamily="{StaticResource DataFont}" FontSize="9" Foreground="{StaticResource GoldBrush}" Text="{Binding LevelLabel}" />
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Width="160" Header="位置 X / Y / Z" Binding="{Binding Position}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DockPanel Margin="0,8,0,0">
                                        <Button x:Name="_removeVehicleButton" DockPanel.Dock="Left" Style="{StaticResource DangerButtonStyle}" Content="删除选中战车" />
                                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="按战车 ID 精确删除，避免误删同类型的其他等级战车。" />
                                    </DockPanel>

                                    <Separator />
                                    <TextBlock Margin="0,0,0,8" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="属性编辑" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="44" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" MinWidth="220" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="2*" MinWidth="170" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="属性（中文名 / ID）" />
                                        <local:CatalogPickerControl x:Name="_vehicleAttribute" Grid.Row="1" ShowIcons="False" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" Text="当前 / 基础" />
                                        <Border x:Name="_vehicleCurrentValueFrame" Grid.Row="1" Grid.Column="2" Padding="10" Background="{StaticResource ScreenBrush}" BorderBrush="{StaticResource BronzeBrush}" BorderThickness="1">
                                            <TextBlock x:Name="_vehicleCurrentValue" Style="{StaticResource CheatStatusStyle}" Text="当前值 -" />
                                        </Border>
                                        <TextBlock Grid.Column="4" Style="{StaticResource CaptionStyle}" Text="新绝对值" />
                                        <local:CheatNumericInput x:Name="_vehicleAttributeValue" Grid.Row="1" Grid.Column="4" Minimum="-1000000000" Maximum="1000000000" DecimalPlaces="3" Increment="0.1" />
                                        <Button x:Name="_modifyVehicleButton" Grid.Row="1" Grid.Column="6" VerticalAlignment="Stretch" Style="{StaticResource BlueButtonStyle}" Content="应用绝对值" />
                                    </Grid>

                                    <TextBlock Margin="0,4,0,8" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="已有战车附魔" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="44" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" MinWidth="240" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="2*" MinWidth="160" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="附魔（0 级移除）" />
                                        <local:CatalogPickerControl x:Name="_vehicleEnchantmentCatalog" Grid.Row="1" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" Text="当前" />
                                        <Border x:Name="_vehicleEnchantmentCurrentFrame" Grid.Row="1" Grid.Column="2" Padding="10" Background="{StaticResource ScreenBrush}" BorderBrush="{StaticResource BronzeBrush}" BorderThickness="1">
                                            <TextBlock x:Name="_vehicleEnchantmentCurrent" Style="{StaticResource CheatStatusStyle}" Text="当前等级 -" />
                                        </Border>
                                        <TextBlock Grid.Column="4" Style="{StaticResource CaptionStyle}" Text="目标等级" />
                                        <local:CheatNumericInput x:Name="_vehicleEnchantmentLevel" Grid.Row="1" Grid.Column="4" Minimum="0" Maximum="2147483647" Value="0" />
                                        <Button x:Name="_setVehicleEnchantmentButton" Grid.Row="1" Grid.Column="6" VerticalAlignment="Stretch" Style="{StaticResource GoldButtonStyle}" Content="设置附魔" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CheatSectionStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0" VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="当前敌人" />
                                        <Button x:Name="_enemyRefreshButton" Grid.Column="2" Content="刷新敌人" />
                                        <TextBlock x:Name="_enemySummary" Grid.Column="4" Style="{StaticResource CheatStatusStyle}" Text="尚未读取敌人" />
                                    </Grid>
                                    <DataGrid x:Name="_enemyGrid" Height="245" RowHeight="52" IsReadOnly="True" SelectionChanged="EnemyGrid_OnSelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="52" Header="图标">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="38" Height="38">
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BronzeBrush}" Text="◇" />
                                                            <Image Source="{Binding Icon}" Stretch="Uniform" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Width="120" Header="运行时 ID" Binding="{Binding RuntimeId}" />
                                            <DataGridTextColumn Width="155" Header="枚举名" Binding="{Binding EnumName}" />
                                            <DataGridTextColumn Width="*" MinWidth="160" Header="中文名" Binding="{Binding Name}" />
                                            <DataGridTextColumn Width="120" Header="生命值" Binding="{Binding Health}" />
                                            <DataGridTextColumn Width="165" Header="位置 X / Y / Z" Binding="{Binding Position}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Separator />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="44" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" MinWidth="220" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="2*" MinWidth="170" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="属性（中文名 / ID）" />
                                        <local:CatalogPickerControl x:Name="_enemyAttribute" Grid.Row="1" ShowIcons="False" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" Text="当前 / 基础" />
                                        <Border x:Name="_enemyCurrentValueFrame" Grid.Row="1" Grid.Column="2" Padding="10" Background="{StaticResource ScreenBrush}" BorderBrush="{StaticResource BronzeBrush}" BorderThickness="1">
                                            <TextBlock x:Name="_enemyCurrentValue" Style="{StaticResource CheatStatusStyle}" Text="当前值 -" />
                                        </Border>
                                        <TextBlock Grid.Column="4" Style="{StaticResource CaptionStyle}" Text="新绝对值" />
                                        <local:CheatNumericInput x:Name="_enemyAttributeValue" Grid.Row="1" Grid.Column="4" Minimum="-1000000000" Maximum="1000000000" DecimalPlaces="3" Increment="0.1" />
                                        <Button x:Name="_modifyEnemyButton" Grid.Row="1" Grid.Column="6" VerticalAlignment="Stretch" Style="{StaticResource BlueButtonStyle}" Content="应用绝对值" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="_generateTab" Header="生成">
                    <ScrollViewer x:Name="_generatePageScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8,10,8,0">
                            <Border Margin="0" Style="{StaticResource CheatSectionStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Margin="0" Style="{StaticResource SectionTitleStyle}" Text="在指定世界坐标生成怪物" />
                                        <TextBlock Margin="16,0,0,0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource CheatStatusStyle}"
                                                   Text="怪物会在中心点附近按生成半径分散出现" />
                                    </DockPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="40" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="280" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="怪物（中文名 / 枚举名 / ID）" />
                                        <local:CatalogPickerControl x:Name="_enemyCatalog" Grid.Row="1" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" Text="自定义等级" />
                                        <local:CheatNumericInput x:Name="_enemyLevel" Grid.Row="1" Grid.Column="2" Minimum="1" Maximum="200" Value="1" />
                                        <TextBlock x:Name="_resolvedLevelLabel"
                                                   Grid.Column="4"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Text="实际等级：跟随当前波次 AI 等级"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        <CheckBox x:Name="_followCurrentLevelCheck" Grid.Row="1" Grid.Column="4" VerticalAlignment="Stretch" FontWeight="Bold" Content="跟随当前关卡" IsChecked="True" />
                                        <TextBlock Grid.Column="6" Style="{StaticResource CaptionStyle}" Text="每点数量" />
                                        <local:CheatNumericInput x:Name="_enemyCount" Grid.Row="1" Grid.Column="6" Minimum="1" Maximum="10" Value="1" />
                                    </Grid>

                                    <Border Height="1" Margin="0,4,0,6" Background="#5A3B25" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="40" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="105" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" MinWidth="105" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" MinWidth="105" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" MinWidth="110" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="X" />
                                        <local:CheatNumericInput x:Name="_spawnX" Grid.Row="1" Minimum="-10000" Maximum="10000" DecimalPlaces="2" Increment="0.5" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" Text="Y" />
                                        <local:CheatNumericInput x:Name="_spawnY" Grid.Row="1" Grid.Column="2" Minimum="-10000" Maximum="10000" DecimalPlaces="2" Increment="0.5" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource CaptionStyle}" Text="Z" />
                                        <local:CheatNumericInput x:Name="_spawnZ" Grid.Row="1" Grid.Column="4" Minimum="-10000" Maximum="10000" DecimalPlaces="2" Increment="0.5" />
                                        <TextBlock Grid.Column="6" Style="{StaticResource CaptionStyle}" Text="生成半径" />
                                        <local:CheatNumericInput x:Name="_spawnRadius" Grid.Row="1" Grid.Column="6" Minimum="0" Maximum="1000" Value="6" DecimalPlaces="2" Increment="0.5" />
                                        <Button x:Name="_capturePointButton"
                                                Grid.Row="1"
                                                Grid.Column="8"
                                                VerticalAlignment="Stretch"
                                                Style="{StaticResource BlueButtonStyle}"
                                                Content="从游戏选点"
                                                ToolTip="进入游戏后按住左 Alt 并单击鼠标左键，选择怪物生成位置。" />
                                        <Button x:Name="_cancelCaptureButton"
                                                Grid.Row="1"
                                                Grid.Column="10"
                                                VerticalAlignment="Stretch"
                                                Content="取消选点" />
                                        <Button x:Name="_addSpawnPointButton"
                                                Grid.Row="1"
                                                Grid.Column="12"
                                                VerticalAlignment="Stretch"
                                                Style="{StaticResource GoldButtonStyle}"
                                                Content="添加坐标" />
                                    </Grid>
                                    <Border Margin="0,0,0,6" Padding="6" Background="{StaticResource ScreenBrush}" BorderBrush="#4E3522" BorderThickness="1">
                                        <TextBlock x:Name="_captureStatusLabel" Style="{StaticResource CheatStatusStyle}" Text="选点状态：未启动" />
                                    </Border>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="68" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="生成位置列表（每个点都会执行一次所选数量）" />
                                        <DataGrid x:Name="_spawnPointGrid" Grid.Row="1" Grid.ColumnSpan="4" IsReadOnly="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="70" Header="序号" Binding="{Binding Number}" />
                                                <DataGridTextColumn Width="120" Header="来源" Binding="{Binding Source}" />
                                                <DataGridTextColumn Width="*" Header="X" Binding="{Binding X}" />
                                                <DataGridTextColumn Width="*" Header="Y" Binding="{Binding Y}" />
                                                <DataGridTextColumn Width="*" Header="Z" Binding="{Binding Z}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock x:Name="_spawnPointSummary" Grid.Row="2" Margin="0,8,12,0" Style="{StaticResource CheatStatusStyle}" Text="尚未添加生成位置" />
                                        <Button x:Name="_removeSpawnPointButton" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Content="删除选中点" />
                                        <Button x:Name="_clearSpawnPointsButton" Grid.Row="2" Grid.Column="3" Margin="0,8,0,0" Content="清空位置" />
                                    </Grid>
                                    <Border Height="1" Margin="0,2,0,4" Background="#5A3B25" />
                                    <DockPanel>
                                        <Button x:Name="_spawnEnemyButton" DockPanel.Dock="Left" Margin="0,0,14,0" Style="{StaticResource GoldButtonStyle}" Content="生成怪物" />
                                        <TextBlock x:Name="_spawnStatusLabel" Style="{StaticResource CheatStatusStyle}" Text="生成状态：尚未执行" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border x:Name="_toastHost"
                    Grid.RowSpan="2"
                    Panel.ZIndex="200"
                    MinWidth="280"
                    MaxWidth="600"
                    Margin="16,58,16,0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#182B36"
                    BorderBrush="#328CC5"
                    BorderThickness="1"
                    CornerRadius="2"
                    Focusable="False"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Visibility="Collapsed"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="作弊工具提示">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="_toastTranslate" Y="-14" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="_toastRail" Background="#328CC5" />
                    <TextBlock x:Name="_toastText"
                               Grid.Column="1"
                               Margin="14,10,14,11"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#F4E8CF"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </controls:MechanicalShell>
</Window>
