<UserControl x:Class="Loopstructor.AutoPlayer.Manager.UI.VehicleQuickSelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Loopstructor.AutoPlayer.Manager.UI"
             x:ClassModifier="internal"
             MinWidth="320"
             MinHeight="250"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Loopstructor.AutoPlayer.Manager;component/UI/GameTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="VehicleTypeButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="68" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="Background" Value="#251E17" />
                <Setter Property="BorderBrush" Value="#654529" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="#49341B" />
                        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="VehicleLevelButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="39" />
                <Setter Property="MinHeight" Value="31" />
                <Setter Property="Height" Value="31" />
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="Padding" Value="5,1" />
                <Setter Property="FontFamily" Value="{StaticResource DataFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Background" Value="#191511" />
                <Setter Property="BorderBrush" Value="#5B3B24" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="#6A491E" />
                        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                        <Setter Property="Foreground" Value="#FFF1C6" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource ScreenBrush}"
                BorderBrush="{StaticResource BronzeBrush}"
                BorderThickness="1"
                CornerRadius="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Margin="1" Background="#2A2118" BorderBrush="#5B3B24" BorderThickness="0,0,1,0">
                    <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Path Data="M7,1 A6,6 0 1 0 7,13 A6,6 0 1 0 7,1 M11.3,11.3 L16,16"
                              Fill="Transparent"
                              Stroke="{StaticResource GoldBrush}"
                              StrokeThickness="1.7" />
                    </Viewbox>
                </Border>
                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox"
                             Padding="9,6"
                             BorderThickness="0"
                             Background="Transparent"
                             AutomationProperties.Name="搜索战车"
                             TextChanged="SearchBox_OnTextChanged" />
                    <TextBlock x:Name="SearchHint"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#8D806E"
                               IsHitTestVisible="False"
                               Text="搜索战车中文名、枚举名、类型或系列…" />
                </Grid>
            </Grid>
        </Border>

        <ItemsControl x:Name="TypeHost" Grid.Row="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:VehicleTypeChoice}">
                    <Button Style="{StaticResource VehicleTypeButtonStyle}"
                            Content="{Binding DisplayName}"
                            AutomationProperties.Name="{Binding AutomationName}"
                            Click="TypeButton_OnClick" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="4"
                MinHeight="180"
                Background="{StaticResource ScreenBrush}"
                BorderBrush="#4E3522"
                BorderThickness="1">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SeriesHost" Margin="6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:VehicleSeriesChoice}">
                                <Border Width="168"
                                        Height="96"
                                        Margin="3"
                                        Padding="6"
                                        CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#211B16" />
                                            <Setter Property="BorderBrush" Value="#654529" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#3B2C1B" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="35" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" VerticalAlignment="Center" Background="#15120F" BorderBrush="#5B3B24" BorderThickness="1">
                                                <Grid>
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BronzeBrush}" Text="◇" />
                                                    <Image Margin="2" Source="{Binding Icon}" Stretch="Uniform" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontFamily="{StaticResource DataFont}"
                                                           FontSize="9"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding FamilyKey}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Levels}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:VehicleLevelChoice}">
                                                    <Button Style="{StaticResource VehicleLevelButtonStyle}"
                                                            Content="{Binding DisplayLevel}"
                                                            AutomationProperties.Name="{Binding AutomationName}"
                                                            Click="LevelButton_OnClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText"
                           Margin="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="没有匹配的战车"
                           Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
