<Window
    x:Class="Loopstructor.AutoPlayer.Manager.UI.MainForm"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Loopstructor.AutoPlayer.Manager.UI.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Loopstructor 2.AutoPlayer Manager"
    Icon="/Loopstructor.AutoPlayer.Manager;component/Assets/Branding/manager-logo-256.png"
    Width="1400"
    Height="860"
    MinWidth="1100"
    MinHeight="680"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    WindowStyle="None"
    AllowsTransparency="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="72"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GameTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,8,8" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="TelemetryCaptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TelemetryValueStyle" TargetType="TextBlock" BasedOn="{StaticResource DataTextStyle}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="VerticalPanelSplitterStyle" TargetType="GridSplitter">
                <Setter Property="Width" Value="16" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="SizeWE" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="{TemplateBinding Background}">
                                <Border
                                    x:Name="Grip"
                                    Width="8"
                                    Margin="3,22"
                                    Background="#2B1B11"
                                    BorderBrush="{StaticResource BronzeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle Width="3" Height="14" Margin="0,0,0,5" Fill="{StaticResource BrassBrush}" />
                                        <Rectangle Width="3" Height="14" Margin="0,0,0,5" Fill="{StaticResource BrassBrush}" />
                                        <Rectangle Width="3" Height="14" Fill="{StaticResource BrassBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Grip" Property="Background" Value="#56361C" />
                                    <Setter TargetName="Grip" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Grip" Property="BorderBrush" Value="{StaticResource SignalGreenBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HorizontalPanelSplitterStyle" TargetType="GridSplitter">
                <Setter Property="Height" Value="18" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="SizeNS" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="{TemplateBinding Background}">
                                <Border
                                    x:Name="Grip"
                                    Width="116"
                                    Height="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#2B1B11"
                                    BorderBrush="{StaticResource BronzeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Rectangle Width="18" Height="3" Margin="0,0,6,0" Fill="{StaticResource BrassBrush}" />
                                        <Rectangle Width="18" Height="3" Margin="0,0,6,0" Fill="{StaticResource BrassBrush}" />
                                        <Rectangle Width="18" Height="3" Fill="{StaticResource BrassBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Grip" Property="Background" Value="#56361C" />
                                    <Setter TargetName="Grip" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Grip" Property="BorderBrush" Value="{StaticResource SignalGreenBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <controls:MechanicalShell
        x:Name="_captureSurface"
        AccentBrush="{StaticResource SignalGreenBrush}"
        BrandText="AUTO PLAY"
        LogoSource="/Loopstructor.AutoPlayer.Manager;component/Assets/Branding/manager-logo-256.png"
        Title="自动游玩控制台">
        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4*" MinHeight="260" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" MinHeight="100" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource InsetPanelStyle}" Padding="14,9" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontFamily="{StaticResource DisplayFont}"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextBrush}"
                            Text="SKYSPINE  /  自动游玩" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock
                                x:Name="ProductVersionLabel"
                                AutomationProperties.Name="AutoPlayer 版本"
                                FontFamily="{StaticResource DataFont}"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{StaticResource GoldBrush}"
                                Text="AutoPlayer 版本" />
                            <TextBlock
                                Margin="14,0,0,0"
                                FontSize="12"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="本机验证 · 后台连接 · 随时控制" />
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border
                            MinWidth="126"
                            Height="36"
                            Margin="0,0,10,0"
                            Padding="10,0"
                            Background="#221B14"
                            BorderBrush="{StaticResource BronzeBrush}"
                            BorderThickness="1"
                            CornerRadius="2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse
                                    x:Name="_connectionLamp"
                                    Width="10"
                                    Height="10"
                                    Margin="0,0,8,0"
                                    Fill="{StaticResource DisabledTextBrush}" />
                                <TextBlock
                                    x:Name="_connectionText"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="未连接" />
                            </StackPanel>
                        </Border>
                        <TextBlock
                            x:Name="_updateState"
                            Width="165"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="尚未检查更新"
                            TextAlignment="Right"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="_updateButton"
                            MinWidth="112"
                            Style="{StaticResource BlueButtonStyle}"
                            Content="检查更新"
                            Click="UpdateButtonOnClick" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" MinWidth="250" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.55*" MinWidth="390" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.9*" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource InstrumentPanelStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" Text="游戏与插件" />
                        <ScrollViewer
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            PanningMode="VerticalOnly">
                            <StackPanel Margin="0,2,8,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Skyspine 打包目录" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="_gamePath"
                                        IsReadOnly="True" />
                                    <Button
                                        x:Name="_browseButton"
                                        Grid.Column="1"
                                        Margin="7,0,0,0"
                                        MinWidth="60"
                                        Style="{StaticResource BlueButtonStyle}"
                                        Content="选择"
                                        Click="BrowseButtonOnClick" />
                                </Grid>
                                <TextBlock
                                    x:Name="_validationState"
                                    Margin="0,0,0,8"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="尚未选择构建"
                                    TextWrapping="Wrap" />

                                <Separator />

                                <TextBlock
                                    x:Name="_pluginState"
                                    Margin="0,3,0,6"
                                    FontWeight="SemiBold"
                                    Text="插件状态：未知"
                                    TextWrapping="Wrap" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="_installButton"
                                        MinWidth="0"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Content="安装"
                                        Click="InstallButtonOnClick" />
                                    <Button
                                        x:Name="_togglePluginButton"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Content="停用"
                                        Click="TogglePluginButtonOnClick" />
                                    <Button
                                        x:Name="_uninstallButton"
                                        Grid.Column="2"
                                        Style="{StaticResource DangerButtonStyle}"
                                        MinWidth="0"
                                        Margin="0"
                                        Content="卸载"
                                        Click="UninstallButtonOnClick" />
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="自动游玩配置名称" />
                                <TextBox
                                    x:Name="_profileName"
                                    Margin="0,0,0,8"
                                    AutomationProperties.Name="自动游玩配置名称" />
                                <CheckBox
                                    x:Name="_continueProfile"
                                    Margin="0,0,0,8"
                                    Content="继续当前配置中的未完成对局" />

                                <Separator />

                                <CheckBox
                                    x:Name="_autoUpdateCheck"
                                    Margin="0,4,0,0"
                                    Content="启动 Manager 时检查更新" />
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="_launchButton"
                                Margin="0,0,7,0"
                                Padding="8,7"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="启动游戏"
                                Click="LaunchButtonOnClick" />
                            <Button
                                x:Name="_cheatButton"
                                Grid.Column="1"
                                Padding="8,7"
                                AutomationProperties.Name="打开作弊工具"
                                Style="{StaticResource GoldButtonStyle}"
                                Content="作弊工具"
                                Click="CheatButtonOnClick" />
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter
                    x:Name="_targetTrackSplitter"
                    Grid.Column="1"
                    AutomationProperties.HelpText="拖拽调整游戏区和运行轨道的宽度"
                    AutomationProperties.Name="调整游戏区宽度"
                    KeyboardIncrement="8"
                    DragIncrement="2"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    ShowsPreview="True"
                    Style="{StaticResource VerticalPanelSplitterStyle}"
                    ToolTip="拖拽调整左右区块宽度" />

                <Border Grid.Column="2" Style="{StaticResource InstrumentPanelStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="72" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6" Text="运行轨道" />

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,8">
                            <Button
                                x:Name="_startButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="0"
                                Margin="0,0,6,0"
                                Content="开始"
                                Click="StartButtonOnClick" />
                            <Button
                                x:Name="_pauseButton"
                                Style="{StaticResource GoldButtonStyle}"
                                MinWidth="0"
                                Margin="0,0,6,0"
                                Content="暂停"
                                Click="PauseButtonOnClick" />
                            <Button
                                x:Name="_resumeButton"
                                Style="{StaticResource BlueButtonStyle}"
                                MinWidth="0"
                                Margin="0,0,6,0"
                                Content="继续"
                                Click="ResumeButtonOnClick" />
                            <Button
                                x:Name="_stopButton"
                                Style="{StaticResource DangerButtonStyle}"
                                MinWidth="0"
                                Margin="0"
                                Content="停止"
                                Click="StopButtonOnClick" />
                        </UniformGrid>

                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="模式" />
                                <ComboBox
                                    x:Name="_mode"
                                    IsEditable="True"
                                    IsTextSearchEnabled="True"
                                    StaysOpenOnEdit="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="速度" />
                                <ComboBox
                                    x:Name="_speed"
                                    AutomationProperties.Name="游戏速度"
                                    IsTextSearchEnabled="True"
                                    ToolTip="默认使用 1x 常速；也可选择跟随游戏当前速度。" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最长分钟" />
                                <TextBox
                                    x:Name="_maxMinutes"
                                    AutomationProperties.Name="最长运行分钟"
                                    LostKeyboardFocus="MaxMinutesOnLostKeyboardFocus" />
                            </StackPanel>
                        </Grid>

                        <Border
                            x:Name="_stageBanner"
                            Grid.Row="3"
                            Margin="0,0,0,8"
                            Padding="10,6"
                            Background="#243A2618"
                            BorderBrush="{StaticResource BronzeBrush}"
                            BorderThickness="1"
                            CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="16" Height="24" VerticalAlignment="Center">
                                    <Rectangle Width="3" Fill="{StaticResource BronzeBrush}" />
                                    <Ellipse
                                        x:Name="_stageLamp"
                                        Width="12"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        Fill="{StaticResource SignalGreenBrush}"
                                        Stroke="{StaticResource CoalBrush}"
                                        StrokeThickness="2" />
                                </Grid>
                                <TextBlock
                                    x:Name="_runState"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource SignalGreenBrush}"
                                    Text="待机 / 等待游戏"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="_stageDetail"
                                    Grid.Column="2"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="游戏连接后可随时开始、暂停或停止自动游玩"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="4" Style="{StaticResource InsetPanelStyle}" Padding="10,8">
                            <Grid>
                                <TextBlock
                                    x:Name="_timelineEmpty"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="等待自动游玩事件" />
                                <ScrollViewer
                                    x:Name="_timelineScroll"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    PanningMode="VerticalOnly">
                                    <ItemsControl x:Name="_timelineItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0">
                                                        <Rectangle Width="3" Fill="#5B3B24" />
                                                        <Ellipse
                                                            Width="12"
                                                            Height="12"
                                                            VerticalAlignment="Top"
                                                            Fill="{Binding Accent}"
                                                            Stroke="{StaticResource ScreenBrush}"
                                                            StrokeThickness="2" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock
                                                            FontFamily="{StaticResource DataFont}"
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            Foreground="{Binding Accent}"
                                                            Text="{Binding Heading}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontSize="12"
                                                            Foreground="{StaticResource TextBrush}"
                                                            Text="{Binding Message}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter
                    x:Name="_trackTelemetrySplitter"
                    Grid.Column="3"
                    AutomationProperties.HelpText="拖拽调整运行轨道和运行遥测的宽度"
                    AutomationProperties.Name="调整运行遥测宽度"
                    KeyboardIncrement="8"
                    DragIncrement="2"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    ShowsPreview="True"
                    Style="{StaticResource VerticalPanelSplitterStyle}"
                    ToolTip="拖拽调整左右区块宽度" />

                <Border Grid.Column="4" Style="{StaticResource InstrumentPanelStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" Text="运行遥测" />
                        <ScrollViewer
                            Grid.Row="1"
                            Margin="0,0,0,8"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            PanningMode="VerticalOnly">
                            <ItemsControl x:Name="_telemetryItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="34" Margin="0,0,6,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Style="{StaticResource TelemetryCaptionStyle}"
                                                Text="{Binding Caption}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource TelemetryValueStyle}"
                                                Text="{Binding Value}"
                                                ToolTip="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button
                            x:Name="_openEvidenceButton"
                            Grid.Row="2"
                            HorizontalAlignment="Left"
                            Style="{StaticResource BlueButtonStyle}"
                            Content="打开证据目录"
                            Click="OpenEvidenceButtonOnClick" />
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter
                x:Name="_logHeightSplitter"
                Grid.Row="2"
                AutomationProperties.HelpText="拖拽调整运行日志区块的高度"
                AutomationProperties.Name="调整运行日志高度"
                KeyboardIncrement="8"
                DragIncrement="2"
                ResizeDirection="Rows"
                ResizeBehavior="PreviousAndNext"
                ShowsPreview="True"
                Style="{StaticResource HorizontalPanelSplitterStyle}"
                ToolTip="拖拽调整上下区块高度" />

            <Border Grid.Row="3" Style="{StaticResource InstrumentPanelStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" Text="运行日志" />
                        <Button
                            HorizontalAlignment="Right"
                            MinWidth="66"
                            MinHeight="30"
                            Padding="10,4"
                            Content="清空"
                            Click="ClearLogsButtonOnClick" />
                    </Grid>
                    <RichTextBox
                        x:Name="_logs"
                        Grid.Row="1"
                        Padding="10,7"
                        IsReadOnly="True"
                        IsUndoEnabled="False"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        Background="{StaticResource CoalBrush}"
                        BorderBrush="{StaticResource BronzeBrush}"
                        BorderThickness="1"
                        FontFamily="{StaticResource DataFont}"
                        FontSize="12"
                        Foreground="{StaticResource TextBrush}" />
                </Grid>
            </Border>
        </Grid>
    </controls:MechanicalShell>
</Window>
