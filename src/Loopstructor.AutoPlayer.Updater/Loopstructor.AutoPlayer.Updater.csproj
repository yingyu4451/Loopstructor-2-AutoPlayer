<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Loopstructor.AutoPlayer.Updater</AssemblyName>
    <RootNamespace>Loopstructor.AutoPlayer.Updater</RootNamespace>
    <ApplicationIcon>..\..\assets\branding\manager.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Verification\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Verification" />
    <InternalsVisibleTo Include="Loopstructor.AutoPlayer.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\branding\manager-logo-256.png">
      <Link>Assets\Branding\manager-logo-256.png</Link>
      <LogicalName>Assets/Branding/manager-logo-256.png</LogicalName>
    </Resource>
  </ItemGroup>
</Project>
