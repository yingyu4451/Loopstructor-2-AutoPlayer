<Window x:Class="Loopstructor.AutoPlayer.Updater.UI.UpdateForm"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Loopstructor.AutoPlayer.Updater.UI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Loopstructor 2.AutoPlayer Updater"
        Width="820"
        Height="650"
        MinWidth="720"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#080706"
        Foreground="#F1DFC0"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ContentRendered="UpdateFormOnContentRendered"
        Closing="UpdateFormOnClosing"
        Closed="UpdateFormOnClosed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="CoalBrush" Color="#0A0907" />
        <SolidColorBrush x:Key="ScreenBrush" Color="#11100C" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#21180F" />
        <SolidColorBrush x:Key="CopperBrush" Color="#8D5A2C" />
        <SolidColorBrush x:Key="DarkCopperBrush" Color="#4F311C" />
        <SolidColorBrush x:Key="BrassBrush" Color="#C18A46" />
        <SolidColorBrush x:Key="GoldBrush" Color="#F0B33A" />
        <SolidColorBrush x:Key="GreenBrush" Color="#79D53B" />
        <SolidColorBrush x:Key="InkBrush" Color="#F1DFC0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A58E6E" />

        <LinearGradientBrush x:Key="FrameBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#9B6737" />
            <GradientStop Offset="0.18" Color="#5E3A20" />
            <GradientStop Offset="0.76" Color="#3C2415" />
            <GradientStop Offset="1" Color="#83502A" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PlaqueBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#2A2118" />
            <GradientStop Offset="0.48" Color="#0B0B08" />
            <GradientStop Offset="1" Color="#17120C" />
        </LinearGradientBrush>

        <Style x:Key="ScrollRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#17120C" />
            <Setter Property="Foreground" Value="#C18A46" />
            <Setter Property="BorderBrush" Value="#4F311C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#0A0907" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Background" Value="#8D5A2C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Margin="2,1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#C18A46"
                                BorderThickness="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="14" />
            <Setter Property="Background" Value="#0A0907" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="15" />
                            </Grid.RowDefinitions>
                            <RepeatButton Grid.Row="0"
                                          Command="{x:Static ScrollBar.LineUpCommand}"
                                          Content="▲"
                                          Style="{StaticResource ScrollRepeatButtonStyle}" />
                            <Track x:Name="PART_Track"
                                   Grid.Row="1"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource ScrollPageButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource ScrollPageButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <RepeatButton Grid.Row="2"
                                          Command="{x:Static ScrollBar.LineDownCommand}"
                                          Content="▼"
                                          Style="{StaticResource ScrollRepeatButtonStyle}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D9C8AC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#8D5A2C"
                                BorderThickness="1,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F0B33A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7B241A" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MachineButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="122" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,4" />
            <Setter Property="Foreground" Value="#FFF0CE" />
            <Setter Property="Background" Value="#8D5A2C" />
            <Setter Property="BorderBrush" Value="#F0B33A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="#070604" BorderBrush="#070604" BorderThickness="2">
                                <Border x:Name="ButtonFace"
                                        Margin="2"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Rectangle Height="1"
                                                   Margin="2,0,2,0"
                                                   VerticalAlignment="Top"
                                                   Fill="#55FFE6B0" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFace" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFace" Property="Margin" Value="3,4,1,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="ButtonFace" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowResizeGripStyle" TargetType="Thumb">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="SizeNWSE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border
                            Background="#20160F"
                            BorderBrush="{StaticResource BrassBrush}"
                            BorderThickness="1">
                            <Grid Margin="4">
                                <Path
                                    Data="M 1,15 L 15,1 M 7,15 L 15,7 M 13,15 L 15,13"
                                    Stroke="{StaticResource GoldBrush}"
                                    StrokeThickness="1.5"
                                    StrokeStartLineCap="Square"
                                    StrokeEndLineCap="Square" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            Background="{StaticResource CoalBrush}"
            BorderBrush="#1F130C"
            BorderThickness="3">
        <Border Background="{StaticResource CoalBrush}"
                BorderBrush="{StaticResource CopperBrush}"
                BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource FrameBrush}"
                        BorderBrush="#D09A56"
                        BorderThickness="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="276" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="14,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="#E8D1A8"
                                   FontFamily="Bahnschrift"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="LOOPSTRUCTOR 2  ·  AUTOPLAYER" />
                        <Border Grid.Column="1"
                                Margin="10,5"
                                Background="{StaticResource PlaqueBrush}"
                                BorderBrush="#0A0704"
                                BorderThickness="3">
                            <Border BorderBrush="{StaticResource BrassBrush}" BorderThickness="1">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource GreenBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Text="自动更新控制台" />
                            </Border>
                        </Border>
                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button AutomationProperties.Name="最小化"
                                    Click="MinimizeButtonOnClick"
                                    Content="—"
                                    Style="{StaticResource WindowButtonStyle}" />
                            <Button x:Name="MaximizeButton"
                                    AutomationProperties.Name="最大化或还原"
                                    Click="MaximizeButtonOnClick"
                                    Content="□"
                                    Style="{StaticResource WindowButtonStyle}" />
                            <Button AutomationProperties.Name="关闭"
                                    Click="CloseButtonOnClick"
                                    Content="✕"
                                    Style="{StaticResource CloseWindowButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="13"
                        Padding="4"
                        Background="{StaticResource FrameBrush}"
                        BorderBrush="#181009"
                        BorderThickness="3">
                    <Border Padding="18,14,18,12"
                            Background="{StaticResource ScreenBrush}"
                            BorderBrush="{StaticResource BrassBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="62" />
                                <RowDefinition Height="76" />
                                <RowDefinition Height="Auto" MinHeight="68" />
                                <RowDefinition Height="25" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="62" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="54" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Foreground="{StaticResource BrassBrush}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Text="版本传输协议" />
                                    <TextBlock x:Name="VersionLabel"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource InkBrush}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Text="当前版本 v0.0.0" />
                                </StackPanel>
                                <Border x:Name="StatusBadgeBorder"
                                        Grid.Column="1"
                                        MinWidth="136"
                                        Height="32"
                                        Padding="11,0"
                                        VerticalAlignment="Center"
                                        Background="#090907"
                                        BorderBrush="{StaticResource CopperBrush}"
                                        BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Ellipse x:Name="StatusIndicator"
                                                 Width="9"
                                                 Height="9"
                                                 Margin="0,0,8,0"
                                                 Fill="{StaticResource GreenBrush}" />
                                        <TextBlock x:Name="StatusBadgeText"
                                                   Foreground="{StaticResource InkBrush}"
                                                   FontWeight="SemiBold"
                                                   Text="准备中" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <local:UpdateStageRail x:Name="StageRail"
                                                   Grid.Row="1"
                                                   Margin="0,0,0,6" />

                            <Border x:Name="StageBanner"
                                    Grid.Row="2"
                                    Margin="0,2,0,8"
                                    Padding="14,8"
                                    Background="#10170D"
                                    BorderBrush="{StaticResource GreenBrush}"
                                    BorderThickness="4,1,1,1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="StageTitle"
                                               Foreground="{StaticResource GreenBrush}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Text="正在准备更新"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="StageDetail"
                                               Grid.Row="1"
                                               Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"
                                               Text="正在初始化安全更新流程。"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="3">
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Text="总更新进度" />
                                <TextBlock x:Name="PercentText"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource GoldBrush}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Text="0%" />
                            </Grid>

                            <local:FlatProgressBar x:Name="OverallProgress" Grid.Row="4" />

                            <Grid Grid.Row="5" Margin="0,9,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               Text="已下载 / 总大小" />
                                    <TextBlock x:Name="DownloadedMetric"
                                               Margin="0,3,0,0"
                                               Foreground="{StaticResource InkBrush}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Text="-" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource DarkCopperBrush}" />
                                <StackPanel Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               Text="下载速度" />
                                    <TextBlock x:Name="SpeedMetric"
                                               Margin="0,3,0,0"
                                               Foreground="{StaticResource GreenBrush}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Text="--" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="6">
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{StaticResource BrassBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="终端记录" />
                                <Border Height="1"
                                        Margin="76,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource DarkCopperBrush}" />
                            </Grid>

                            <Border Grid.Row="7"
                                    Background="#070705"
                                    BorderBrush="{StaticResource DarkCopperBrush}"
                                    BorderThickness="1">
                                <RichTextBox x:Name="DetailsBox"
                                             AutomationProperties.Name="更新详细状态"
                                             Padding="12,8"
                                             IsReadOnly="True"
                                             IsDocumentEnabled="True"
                                             VerticalScrollBarVisibility="Auto"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#D8CBB5"
                                             FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                             FontSize="12"
                                             CaretBrush="{StaticResource GoldBrush}"
                                             SelectionBrush="#2D789C"
                                             SelectionOpacity="0.92"
                                             IsInactiveSelectionHighlightEnabled="True" />
                            </Border>

                            <Grid Grid.Row="8" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FooterHint"
                                           Margin="0,0,18,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Text="当前阶段可安全取消。"
                                           TextWrapping="Wrap" />
                                <Button x:Name="ActionButton"
                                        Grid.Column="1"
                                        AutomationProperties.Name="取消更新"
                                        Click="ActionButtonOnClick"
                                        Content="取消"
                                        Style="{StaticResource MachineButtonStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Border>

                <Ellipse Grid.Row="1" Width="11" Height="11" Margin="13" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="#1A120C" Stroke="#B47B3D" StrokeThickness="2" />
                <Thumb
                    Grid.Row="1"
                    Margin="0,0,10,10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="20"
                    DragDelta="ResizeGripOnDragDelta"
                    ToolTip="拖拽调整窗口大小"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{StaticResource WindowResizeGripStyle}" />
            </Grid>
        </Border>
    </Border>
</Window>
