{
  "name": "loopstructor-autoplayer-desktop",
  "version": "0.6.62",
  "private": true,
  "description": "Loopstructor AutoPlayer unified Electron desktop client",
  "author": "yingyu4451",
  "main": "dist-main/main.cjs",
  "type": "module",
  "scripts": {
    "build": "pnpm build:renderer && pnpm build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run && pnpm test:main",
    "test:main": "pnpm build:main && node --test dist-main/updater-relocator.test.cjs",
    "start": "pnpm build && electron .",
    "package:dir": "pnpm build && electron-builder --win --dir",
    "package:dir:only": "electron-builder --win --dir",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@iconify-icons/mdi": "2.0.0",
    "@iconify/vue": "5.0.1",
    "gsap": "3.15.0",
    "pinia": "4.0.3",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.2",
    "@vue/test-utils": "2.5.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.10.0",
    "happy-dom": "20.12.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "build": {
    "appId": "com.loopstructor.autoplayer.manager",
    "productName": "Loopstructor AutoPlayer",
    "asar": true,
    "directories": {
      "output": "dist-electron",
      "buildResources": "../assets/branding"
    },
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "!dist-main/**/*.test.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../assets/branding/manager-logo-256.png",
        "to": "branding/manager-logo-256.png"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "../assets/branding/manager.ico",
      "executableName": "Loopstructor.AutoPlayer.Manager"
    }
  },
  "packageManager": "pnpm@11.19.0"
}
